{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/main.tsx",
    "src/sw.ts",
    "src/workers/**/*.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{js,mjs}"
  ],
  "ignore": [
    "**/*.test.{ts,tsx}",
    "**/*.spec.{ts,tsx}",
    "e2e/**/*",
    "playwright-report/**/*",
    "test-results/**/*",
    "dist/**/*",
    "build/**/*",
    "node_modules/**/*",
    "docs/**/*",
    "public/**/*",
    "vite.config.ts",
    "tailwind.config.ts",
    "postcss.config.js",
    "playwright.config.ts",
    "vitest.config.ts",
    "eslint.config.js"
  ],
  "ignoreDependencies": [
    "@playwright/test",
    "gh-pages",
    "fake-indexeddb",
    "jsdom",
    "vitest"
  ],
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": false
}
