{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.tsx",
    "src/sw.ts",
    "src/workers/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.mjs"
  ],
  "ignore": [
    "app/**",
    "components/**",
    "lib/**",
    "docs/**",
    "e2e/**",
    "playwright-report/**",
    "test-results/**",
    "public/**",
    "dist/**",
    "supabase/**",
    "**/*.config.{js,ts}",
    "**/*.setup.ts",
    "src/vite-env.d.ts"
  ],
  "ignoreDependencies": [
    "@types/*",
    "vite",
    "typescript",
    "eslint",
    "prettier",
    "tailwindcss",
    "postcss",
    "autoprefixer",
    "vitest",
    "playwright",
    "@vitejs/plugin-react-swc",
    "vite-plugin-pwa"
  ],
  "ignoreBinaries": ["gh-pages"]
}
