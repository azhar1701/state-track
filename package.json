{
  "name": "state-track",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "description": "A Vite + React app for infrastructure report mapping.",
  "homepage": "https://azhar1701.github.io/state-track/",
  "repository": {
    "type": "git",
    "url": "https://github.com/azhar1701/state-track.git"
  },
  "author": "azhar1701",
  "license": "MIT",
  "scripts": {
    "env:init": "node -e \"const fs=require('fs');const cp=(s,t)=>fs.existsSync(s)&&!fs.existsSync(t)&&fs.copyFileSync(s,t);cp('.env.local.example','.env.local');cp('.env.example','.env');console.log('Initialized .env files (if missing).');\"",
    "predev": "node scripts/preflight-env.mjs",
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node ./scripts/postbuild-copy.mjs",
    "build:dev": "vite build --mode development",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint .",
    "test": "npx vitest run",
    "test:watch": "npx vitest",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "knip": "knip",
    "knip:production": "knip --production",
    "health:regions": "node scripts/check-ciamis.mjs",
    "health:app": "node scripts/check-app-health.mjs",
    "health:storage": "node scripts/check-storage-upload.mjs",
    "seed:ciamis": "node scripts/seed-ciamis.mjs",
    "seed:ciamis-csv": "node scripts/seed-ciamis-from-csv.mjs",
    "fetch:ciamis-wiki": "node scripts/fetch-ciamis-wiki.mjs",
    "preview": "vite preview",
    "deploy": "vite build && gh-pages -d dist",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug"
  },
